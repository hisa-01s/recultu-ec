{"locale_data":{"messages":{"":{"plural_forms":"nplurals=1; plural=0;","language":"ja_JP","project_id_version":"WooCommerce - WooCommerce Payments"},"{{wrapper}}Review store settings{{\/wrapper}}":["{{wrapper}}\u5e97\u8217\u306e\u8a2d\u5b9a\u3092\u898b\u76f4\u3059{{\/wrapper}}"],"A currency switcher is also available in your widgets.":["\u30a6\u30a3\u30b8\u30a7\u30c3\u30c8\u3067\u901a\u8ca8\u5207\u308a\u66ff\u3048\u3082\u53ef\u80fd\u3067\u3059\u3002"],"Automatically switch customers to their local currency if it has been enabled":["\u73fe\u5730\u901a\u8ca8\u3078\u306e\u5207\u308a\u66ff\u3048\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u9867\u5ba2\u3092\u81ea\u52d5\u7684\u306b\u73fe\u5730\u901a\u8ca8\u306b\u5207\u308a\u66ff\u3048\u308b"],"These settings can be changed any time by visiting the Multi-Currency settings":["\u3053\u308c\u3089\u306e\u8a2d\u5b9a\u306f\u3001\u591a\u901a\u8ca8\u306e\u8a2d\u5b9a\u3067\u3044\u3064\u3067\u3082\u5909\u66f4\u3067\u304d\u307e\u3059"],"Add a currency switcher to the Storefront theme on breadcrumb section.":["\u30b9\u30c8\u30a2\u30d5\u30ed\u30f3\u30c8\u30c6\u30fc\u30de\u306e\u30d1\u30f3\u304f\u305a\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u901a\u8ca8\u5207\u308a\u66ff\u3048\u6a5f\u80fd\u3092\u8ffd\u52a0\u3002"],"Customers will be notified via store alert banner.":["\u9867\u5ba2\u306b\u306f\u30b9\u30c8\u30a2\u30a2\u30e9\u30fc\u30c8\u30d0\u30ca\u30fc\u3067\u304a\u77e5\u3089\u305b\u3057\u307e\u3059\u3002"],"Preview":["\u30d7\u30ec\u30d3\u30e5\u30fc"],"Continue":["\u6b21\u3078"]}}}